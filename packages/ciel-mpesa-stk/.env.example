# Ciel M-Pesa STK Push — configuration. Copy to .env (never commit .env).
# Start with SANDBOX keys from https://developer.safaricom.co.ke

# sandbox | production
MPESA_ENV=sandbox

# From your Daraja app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Paybill number, or for a Till: the store / head-office number (sandbox test shortcode: 174379)
MPESA_SHORTCODE=
# Lipa na M-Pesa Online passkey for that shortcode
MPESA_PASSKEY=
# Only for Buy Goods (Till) payments: the till number customers pay to
MPESA_TILL=

# The public https address of this app. Daraja sends results to
#   MPESA_PUBLIC_URL + MPESA_BASE_PATH + /callback/ + MPESA_CALLBACK_SECRET
MPESA_PUBLIC_URL=https://shop.example.com
MPESA_BASE_PATH=/mpesa
# Long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MPESA_CALLBACK_SECRET=
