{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/muse/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wanja/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/domains(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/domains-order",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/domains/order",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/domains-admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/domains/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/domains/:path*",
      "destination": "/api/domains?route=:path*"
    },
    {
      "source": "/domains/order",
      "destination": "/domains-order"
    },
    {
      "source": "/domains/admin",
      "destination": "/domains-admin"
    },
    {
      "source": "/domains/terms",
      "destination": "/domains-terms"
    },
    {
      "source": "/apex-motion/((?!.*\\.).*)",
      "destination": "/apex-motion"
    },
    {
      "source": "/njia/((?!.*\\.).*)",
      "destination": "/njia"
    },
    {
      "source": "/wanja/portfolio/:chapter(lifestyle|fashion|glamour|commercial)",
      "destination": "/wanja/portfolio"
    },
    {
      "source": "/muse/portfolio/:chapter(portraits|beauty|editorial|campaigns)",
      "destination": "/muse/portfolio"
    }
  ],
  "redirects": [
    {
      "source": "/nice",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/next",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/estora",
      "destination": "/reside-ke",
      "permanent": true
    },
    {
      "source": "/estora/:path*",
      "destination": "/reside-ke/:path*",
      "permanent": true
    },
    {
      "source": "/wanja/rate-card",
      "destination": "/wanja/rates",
      "permanent": true
    },
    {
      "source": "/wanja/services",
      "destination": "/wanja/rates",
      "permanent": false
    }
  ]
}
